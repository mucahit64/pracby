NODE_ENV=production
PORT=3000

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=pracby
DB_PASSWORD=change-me-strong-password
DB_NAME=pracbydb

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# CORS — comma-separated origins (e.g. https://pracby.com,https://www.pracby.com)
ALLOWED_ORIGINS=https://pracby.com

# Frontend API base URL (your VPS public IP or domain)
API_BASE_URL=https://pracby.com

# SSL domain (for nginx/certbot)
DOMAIN=pracby.com
